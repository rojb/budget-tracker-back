NODE_ENV=development
PORT=3000

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=budget_tracker
DATABASE_PASSWORD=budget_tracker
DATABASE_NAME=budget_tracker

# Secret used to sign access tokens (min 32 characters). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-change-me-change-me-change-me
# Access token lifetime (default 7d). No refresh token.
JWT_EXPIRES_IN=7d
# Directory where goal photos are stored (default storage/photos); git-ignored.
PHOTOS_DIR=storage/photos
